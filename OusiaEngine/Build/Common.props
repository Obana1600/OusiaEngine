<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <!-- パス -->
    <PropertyGroup Label="UserMacros">
        <SourceRoot>$(MSBuildThisFileDirectory)..\</SourceRoot>
        <RepoRoot>$(SourceRoot)..\</RepoRoot>
        <SourceDir>$([System.IO.Path]::GetFullPath('$(SourceRoot)').TrimEnd('\').Replace('\', '/'))</SourceDir>
        <ProjectSourceDir>$(MSBuildProjectDirectory.Replace('\', '/'))</ProjectSourceDir>
    </PropertyGroup>

    <!-- 出力設定 -->
    <PropertyGroup>
        <OutDir>$(RepoRoot)Generated\Outputs\$(Configuration)\</OutDir>
        <OutDir Condition="'$(ConfigurationType)'=='Application'">$(RepoRoot)Generated\Outputs\$(Configuration)\$(ProjectName)\</OutDir>
        <IntDir>$(RepoRoot)Generated\Obj\$(ProjectName)\$(Configuration)\</IntDir>
        <ExternalIncludePath>$(SourceRoot)External;
                             $(SourceRoot)External\freetype\include;
                             $(SourceRoot)External\box3d\include;
        $(ExternalIncludePath)</ExternalIncludePath>
    </PropertyGroup>

    <!-- 共通設定-->
    <ItemDefinitionGroup>
        <ClCompile>
            <LanguageStandard>stdcpp20</LanguageStandard>
            <ConformanceMode>true</ConformanceMode>
            <WarningLevel>Level4</WarningLevel>
            <TreatWarningAsError>true</TreatWarningAsError>
            <SDLCheck>true</SDLCheck>
            <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
            <MultiProcessorCompilation>true</MultiProcessorCompilation>
            <AdditionalOptions>/utf-8 /Zc:preprocessor %(AdditionalOptions)</AdditionalOptions>
            <PreprocessorDefinitions>NOMINMAX;SPDLOG_WCHAR_FILENAMES;SOURCE_DIR="$(SourceDir)";PROJECT_DIR="$(ProjectSourceDir)";%(PreprocessorDefinitions)</PreprocessorDefinitions>
            <AdditionalIncludeDirectories>$(SourceRoot)Engine;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
        </ClCompile>
    </ItemDefinitionGroup>

    <!-- Debug -->
    <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
        <ClCompile>
            <PreprocessorDefinitions>_DEBUG;WITH_EDITOR;USE_IMGUI;%(PreprocessorDefinitions)</PreprocessorDefinitions>
            <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
            <Optimization>Disabled</Optimization>
        </ClCompile>
    </ItemDefinitionGroup>

    <!-- Develop -->
    <ItemDefinitionGroup Condition="'$(Configuration)'=='Develop'">
        <ClCompile>
            <PreprocessorDefinitions>_DEVELOP;WITH_EDITOR;USE_IMGUI;%(PreprocessorDefinitions)</PreprocessorDefinitions>
            <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
            <Optimization>MaxSpeed</Optimization>
        </ClCompile>
    </ItemDefinitionGroup>

    <!-- Release -->
    <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
        <ClCompile>
            <PreprocessorDefinitions>NDEBUG;_RELEASE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
            <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
            <Optimization>MaxSpeed</Optimization>
        </ClCompile>
        <Link>
            <OptimizeReferences>true</OptimizeReferences>
            <EnableCOMDATFolding>true</EnableCOMDATFolding>
        </Link>
    </ItemDefinitionGroup>

    <!-- Copy -->
    <Target Name="CopyRuntimeFiles" AfterTargets="Build" Condition="'$(ConfigurationType)'=='Application'">
        <ItemGroup>
            <RuntimeDll Include="$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxcompiler.dll" />
            <RuntimeDll Include="$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxil.dll" />
        </ItemGroup>
        <Copy SourceFiles="@(RuntimeDll)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />

        <ItemGroup Condition="'$(Configuration)'=='Release'">
            <ReleaseFile Include="$(SourceRoot)Engine\EngineAssets\**\*" Folder="EngineAssets" />
            <ReleaseFile Include="$(ProjectDir)Assets\**\*" Folder="Assets" />
            <ReleaseFile Include="$(ProjectDir)ProjectSettings\**\*" Folder="ProjectSettings" />
        </ItemGroup>
        <Copy SourceFiles="@(ReleaseFile)" DestinationFiles="@(ReleaseFile->'$(TargetDir)%(Folder)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    </Target>

</Project>