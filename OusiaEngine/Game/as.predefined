	void set_localScale(const Vector3&in value) property;
	Vector3 get_lossyScale() const property;
	Vector3 get_forward() const property;
	Vector3 get_right() const property;
	Vector3 get_up() const property;
	Transform@ get_parent() const property;
	void set_parent(Transform@ value) property;
	int get_childCount() const property;
	Transform@ GetChild(int index) const;
