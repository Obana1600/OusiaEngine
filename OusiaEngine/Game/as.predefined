	void AddTorque(const Vector3&in torque, ForceMode mode = ForceMode::Force);
	void AddRelativeForce(const Vector3&in force, ForceMode mode = ForceMode::Force);
	void AddRelativeTorque(const Vector3&in torque, ForceMode mode = ForceMode::Force);
	void AddForceAtPosition(const Vector3&in force, const Vector3&in position, ForceMode mode = ForceMode::Force);
	void MovePosition(const Vector3&in position);
	void MoveRotation(const Quaternion&in rotation);
	void Sleep();
	void WakeUp();
	bool IsSleeping() const;
