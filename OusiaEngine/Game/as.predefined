class Object {
	string get_name() const property;
	void set_name(const string&in value) property;
	int GetInstanceID() const;
	GameObject@ opCast();
	const GameObject@ opCast() const;
	Component@ opCast();
	const Component@ opCast() const;
	Behavior@ opCast();
	const Behavior@ opCast() const;
	Transform@ opCast();
	const Transform@ opCast() const;
	Collider@ opCast();
	const Collider@ opCast() const;
	Rigidbody@ opCast();
	const Rigidbody@ opCast() const;
	CharacterController@ opCast();
	const CharacterController@ opCast() const;
}
class GameObject {
	GameObject(const string&in name = "GameObject");
	Object@ opImplCast();
	const Object@ opImplCast() const;
	string get_name() const property;
	void set_name(const string&in value) property;
	int GetInstanceID() const;
	bool get_activeSelf() const property;
	bool get_activeInHierarchy() const property;
	void SetActive(bool value);
	int get_layer() const property;
	void set_layer(int value) property;
	Transform@ get_transform() const property;
	bool TryGetComponent(?&out component) const;
}
