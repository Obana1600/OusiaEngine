class Transform {
	Component@ opImplCast();
	const Component@ opImplCast() const;
	Object@ opImplCast();
	const Object@ opImplCast() const;
	string get_name() const property;
	void set_name(const string&in value) property;
	int GetInstanceID() const;
	GameObject@ get_gameObject() const property;
	Transform@ get_transform() const property;
	Vector3 get_position() const property;
	void set_position(const Vector3&in value) property;
	Vector3 get_localPosition() const property;
	void set_localPosition(const Vector3&in value) property;
	Quaternion get_rotation() const property;
	void set_rotation(const Quaternion&in value) property;
	Quaternion get_localRotation() const property;
	void set_localRotation(const Quaternion&in value) property;
	Vector3 get_eulerAngles() const property;
	void set_eulerAngles(const Vector3&in value) property;
	Vector3 get_localEulerAngles() const property;
	void set_localEulerAngles(const Vector3&in value) property;
